# Copia in .env sul server (/opt/my-erp-crm/.env) e compila. Il file non va mai su GitHub.
DOMAIN=erp.kliniksanktmoritz.ch

POSTGRES_USER=myerp
POSTGRES_PASSWORD=
# Password principale per la gestione dei database (lunga e casuale)
MASTER_PASSWORD=
# Password dell'utente "admin" creata al primo avvio
ADMIN_PASSWORD=
ADMIN_LANG=it_IT

# Azienda che vende (primo avvio)
COMPANY_NAME=
COMPANY_COUNTRY=GB
COMPANY_VAT=
COMPANY_REGISTRY=
COMPANY_STREET=
COMPANY_CITY=
COMPANY_ZIP=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_WEBSITE=
PUBLIC_CURRENCY=EUR

# IVA (società britannica non registrata alla VAT)
# 1 solo dopo la registrazione al regime OSS non-UE: sblocca i servizi digitali a privati UE
OSS_REGISTERED=0
# Campo booleano della posizione fiscale di un modulo di autofatturazione (vuoto se non c'è)
SELF_BILLING_FLAG_FIELD=

# Applicazioni installate al primo avvio
APPS=crm,sale_management,contacts,calendar,account,my_erp_crm_currency_ecb,my_erp_crm_iva
