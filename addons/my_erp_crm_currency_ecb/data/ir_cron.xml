<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_update_ecb_rates" model="ir.cron">
        <field name="name">Tassi di cambio: aggiornamento BCE</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_ecb_rates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d 16:30:00')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
