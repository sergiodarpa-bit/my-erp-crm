<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="controllo_negozio_view_form" model="ir.ui.view">
        <field name="name">my_erp_crm.controllo.negozio.form</field>
        <field name="model">my_erp_crm.controllo.negozio</field>
        <field name="arch" type="xml">
            <form string="Controllo di lancio del negozio" create="0">
                <header>
                    <button name="action_ricontrolla" type="object" string="Ricontrolla" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Controllo di lancio del negozio</h1>
                    </div>
                    <group>
                        <field name="website_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="pronto" string="Pronto per aprire" readonly="1"/>
                    </group>
                    <field name="risultato" nolabel="1" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="controllo_negozio_action" model="ir.actions.act_window">
        <field name="name">Controllo di lancio</field>
        <field name="res_model">my_erp_crm.controllo.negozio</field>
        <field name="path">controllo-negozio</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="controllo_negozio_menu"
              name="Controllo di lancio"
              parent="website_sale.menu_ecommerce_settings"
              action="controllo_negozio_action"
              groups="sales_team.group_sale_manager"
              sequence="1"/>
</odoo>
