<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- "Powered by my-erp-crm" ovunque venga usato il messaggio standard (portale, sondaggi, sito...) -->
    <template id="brand_promotion_message" inherit_id="web.brand_promotion_message">
        <xpath expr="//t[@t-set='odoo_logo']" position="replace">
            <t t-set="odoo_logo">
                <a target="_blank" href="https://github.com/sergiodarpa-bit/my-erp-crm"
                   class="badge text-bg-light">my-erp-crm</a>
            </t>
        </xpath>
    </template>

    <!-- Pagina di accesso: logo sempre visibile (quello di my-erp-crm finché l'azienda
         non carica il proprio, vedi controllers/binary.py) -->
    <template id="login_layout" inherit_id="web.login_layout">
        <xpath expr="//div[img[contains(@t-attf-src, 'company_logo')]]" position="attributes">
            <attribute name="t-if">True</attribute>
        </xpath>
        <xpath expr="//a[contains(@href, 'utm_medium=auth')]" position="replace">
            <t t-call="web.brand_promotion_message">
                <t t-set="_message"/>
                <t t-set="_utm_medium" t-valuef="auth"/>
            </t>
        </xpath>
    </template>

</odoo>
