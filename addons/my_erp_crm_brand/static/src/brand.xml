<?xml version="1.0" encoding="utf-8"?>
<templates>

    <!-- Titoli delle finestre (es. "Odoo Server Error" -> "my-erp-crm Server Error"), in ogni lingua -->
    <t t-inherit="web.Dialog.header" t-inherit-mode="extension">
        <xpath expr="//h4[hasclass('modal-title')]/t[@t-esc='props.title']" position="attributes">
            <attribute name="t-esc">props.title and props.title.toString().replaceAll('Odoo', 'my-erp-crm')</attribute>
        </xpath>
    </t>

    <!-- Impostazioni > Informazioni: nome del prodotto e note di licenza -->
    <t t-inherit="res_config_edition" t-inherit-mode="extension">
        <xpath expr="//h3" position="replace">
            <h3 class="px-0">my-erp-crm <t t-esc="serverVersion"/></h3>
        </xpath>
        <xpath expr="//div[@id='settings']/small" position="replace">
            <small>
                <span>Based on Odoo Community Edition.</span> Copyright © 2004 <a target="_blank" href="https://www.odoo.com" style="text-decoration: underline;">Odoo S.A.</a> · <a id="license" target="_blank" href="https://www.gnu.org/licenses/lgpl-3.0.html" style="text-decoration: underline;">GNU LGPL Licensed</a> · <a target="_blank" href="https://github.com/sergiodarpa-bit/my-erp-crm" style="text-decoration: underline;">Source code</a>
            </small>
        </xpath>
    </t>

</templates>
