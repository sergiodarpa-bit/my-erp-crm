<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Scheda evento: blocco "Prenotazione" con stato, azioni, risposte e link di gestione -->
    <record id="view_calendar_event_form_inherit_appointment" model="ir.ui.view">
        <field name="name">calendar.event.view.form.inherit.appointment</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <button name="action_open_composer" position="before">
                <button name="action_appointment_confirm" type="object" string="Conferma prenotazione"
                        class="btn btn-primary" invisible="appointment_state != 'pending'"/>
                <button name="action_appointment_cancel_from_form" type="object" string="Cancella prenotazione"
                        class="btn btn-secondary" invisible="not appointment_state or appointment_state == 'cancelled'"
                        confirm="La prenotazione sara' cancellata e chi ha prenotato ricevera' un'email. Continuare?"/>
                <field name="appointment_state" widget="statusbar" invisible="not appointment_state"/>
            </button>
            <page name="notes" position="before">
                <page name="appointment" string="Prenotazione" invisible="not appointment_type_id">
                    <group>
                        <group>
                            <field name="appointment_type_id" readonly="1"/>
                            <field name="appointment_booker_id" readonly="1"/>
                            <field name="appointment_company_name" readonly="1"/>
                            <field name="appointment_tz" readonly="1"/>
                            <field name="appointment_guest_emails" readonly="1"/>
                        </group>
                        <group>
                            <field name="appointment_manage_url" widget="url" readonly="1"/>
                            <field name="appointment_can_self_manage" readonly="1" string="Modificabile da chi ha prenotato"/>
                            <field name="appointment_cancelled_by" readonly="1" invisible="appointment_state != 'cancelled'"/>
                            <field name="appointment_cancel_reason" readonly="1" invisible="appointment_state != 'cancelled'"/>
                        </group>
                    </group>
                    <field name="appointment_answer_ids" readonly="1">
                        <list>
                            <field name="question_name"/>
                            <field name="value"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

    <!-- Elenco delle prenotazioni -->
    <record id="calendar_event_view_list_appointment" model="ir.ui.view">
        <field name="name">calendar.event.view.list.appointment</field>
        <field name="model">calendar.event</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list string="Prenotazioni" default_order="start desc, id desc"
                  decoration-muted="appointment_state == 'cancelled'" decoration-warning="appointment_state == 'pending'">
                <field name="start" string="Inizio"/>
                <field name="appointment_type_id"/>
                <field name="appointment_booker_id"/>
                <field name="user_id" string="Con"/>
                <field name="appointment_state" widget="badge"
                       decoration-success="appointment_state == 'confirmed'"
                       decoration-warning="appointment_state == 'pending'"
                       decoration-danger="appointment_state == 'cancelled'"/>
                <field name="opportunity_id" optional="hide"/>
                <field name="videocall_location" optional="hide"/>
                <field name="active" column_invisible="1"/>
                <button name="action_appointment_confirm" type="object" string="Conferma" icon="fa-check"
                        invisible="appointment_state != 'pending'"/>
            </list>
        </field>
    </record>

    <record id="calendar_event_view_search_appointment" model="ir.ui.view">
        <field name="name">calendar.event.view.search.appointment</field>
        <field name="model">calendar.event</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <search string="Prenotazioni">
                <field name="appointment_booker_id"/>
                <field name="appointment_type_id"/>
                <field name="user_id"/>
                <filter string="In attesa" name="pending" domain="[('appointment_state', '=', 'pending')]"/>
                <filter string="Confermate" name="confirmed" domain="[('appointment_state', '=', 'confirmed')]"/>
                <filter string="Cancellate" name="cancelled" domain="[('appointment_state', '=', 'cancelled'), ('active', '=', False)]"/>
                <separator/>
                <filter string="Future" name="upcoming" domain="[('start', '>=', 'now')]"/>
                <filter string="Mie" name="mine" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Attive" name="active" domain="[('active', '=', True)]"/>
                <group>
                    <filter string="Tipo di appuntamento" name="group_type" domain="[]" context="{'group_by': 'appointment_type_id'}"/>
                    <filter string="Persona" name="group_user" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter string="Stato" name="group_state" domain="[]" context="{'group_by': 'appointment_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="calendar_event_action_appointment" model="ir.actions.act_window">
        <field name="name">Prenotazioni</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="domain">[('appointment_type_id', '!=', False)]</field>
        <field name="context">{'search_default_upcoming': 1, 'search_default_active': 1}</field>
        <field name="search_view_id" ref="calendar_event_view_search_appointment"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nessuna prenotazione ancora</p>
            <p>Le prenotazioni fatte dal sito compaiono qui e nel calendario della persona che le riceve.</p>
        </field>
    </record>

    <record id="calendar_event_action_appointment_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="calendar_event_view_list_appointment"/>
        <field name="act_window_id" ref="calendar_event_action_appointment"/>
    </record>

    <record id="calendar_event_action_appointment_view_calendar" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="calendar.view_calendar_event_calendar"/>
        <field name="act_window_id" ref="calendar_event_action_appointment"/>
    </record>

    <record id="calendar_event_action_appointment_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="calendar.view_calendar_event_form"/>
        <field name="act_window_id" ref="calendar_event_action_appointment"/>
    </record>

</odoo>
