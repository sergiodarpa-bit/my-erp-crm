<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_appointment">
        <field name="name">Prenotazioni</field>
        <field name="sequence">12</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>

    <record id="group_appointment_user" model="res.groups">
        <field name="name">Utente</field>
        <field name="comment">Utente: vede i tipi di appuntamento e cura orari, domande e prenotazioni dei tipi in cui compare.</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_appointment"/>
    </record>

    <record id="group_appointment_manager" model="res.groups">
        <field name="name">Responsabile</field>
        <field name="comment">Responsabile: crea, modifica e pubblica i tipi di appuntamento, vede tutte le prenotazioni.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_appointment"/>
        <field name="implied_ids" eval="[(4, ref('group_appointment_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
