<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sequenza_abbonamento" model="ir.sequence">
        <field name="name">Abbonamenti</field>
        <field name="code">my_erp_crm.abbonamento</field>
        <field name="prefix">ABB/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Ogni giorno: rinnovi in scadenza, nuovi tentativi, chiusure dei disdetti. -->
    <record id="cron_rinnovo_abbonamenti" model="ir.cron">
        <field name="name">Abbonamenti: rinnovi e addebiti</field>
        <field name="model_id" ref="model_my_erp_crm_abbonamento"/>
        <field name="state">code</field>
        <field name="code">model._cron_rinnova()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <!-- Scheda «Abbonamenti» nella pagina iniziale del portale clienti. -->
    <record id="portal_abbonamenti" model="portal.entry">
        <field name="name">Subscriptions</field>
        <field name="description">See your subscriptions, the next payment, cancel or pay a renewal</field>
        <field name="url">/my/subscriptions</field>
        <field name="image" type="bytes" file="sale/static/src/img/bag.svg"/>
        <field name="placeholder_count">subscription_count</field>
        <field name="category">client_category</field>
        <field name="sequence" eval="55"/>
    </record>
</odoo>
