#. odoo-python
#: code:addons/my_erp_crm_subscription/models/abbonamento.py:0
msgid "Suspended"
msgstr "Sospeso"

#. module: my_erp_crm_subscription
#: model_terms:ir.ui.view,arch_db:my_erp_crm_subscription.portal_my_abbonamento
msgid "The renewal of this subscription is waiting for payment."
msgstr "Il rinnovo di questo abbonamento è in attesa di pagamento."

#. module: my_erp_crm_subscription
#. odoo-python
#: code:addons/my_erp_crm_subscription/models/abbonamento.py:0
msgid ""
"The renewal of your subscription %(name)s (%(amount)s %(recurrence)s) is "
"ready to be paid."
msgstr "Il rinnovo del tuo abbonamento %(name)s (%(amount)s %(recurrence)s) è pronto da pagare."

#. module: my_erp_crm_subscription
#. odoo-python
#: code:addons/my_erp_crm_subscription/models/abbonamento.py:0
msgid "To change the card used for the next renewals: %s"
msgstr "Per cambiare la carta dei prossimi rinnovi: %s"

#. module: my_erp_crm_subscription
#. odoo-python
#: code:addons/my_erp_crm_subscription/models/abbonamento.py:0
msgid ""
"We could not charge your card for the renewal of your subscription %(name)s "
"(%(amount)s %(recurrence)s)."
msgstr "Non siamo riusciti ad addebitare sulla tua carta il rinnovo del tuo abbonamento %(name)s (%(amount)s %(recurrence)s)."

#. module: my_erp_crm_subscription
#. odoo-python
#: code:addons/my_erp_crm_subscription/models/abbonamento.py:0
msgid "You can pay it online here: %s"
msgstr "Puoi pagarlo online qui: %s"

#. module: my_erp_crm_subscription
#. odoo-python
#: code:addons/my_erp_crm_subscription/models/abbonamento.py:0
msgid "You can pay the renewal online, also with another card, here: %s"
msgstr "Puoi pagare il rinnovo online, anche con un'altra carta, qui: %s"

#. module: my_erp_crm_subscription
#: model_terms:ir.ui.view,arch_db:my_erp_crm_subscription.portal_my_abbonamenti
msgid "You have no subscriptions."
msgstr "Non hai abbonamenti."

#. module: my_erp_crm_subscription
#: model_terms:ir.ui.view,arch_db:my_erp_crm_subscription.avviso_abbonamento_pagamento
msgid ""
"Your card is saved securely with our payment provider. By paying, you "
"authorise us to charge these amounts to the same card at each renewal, until"
" you cancel. You can cancel at any time from your account (Subscriptions) or"
" from the link in our emails; the period already paid stays active until its"
" end."
msgstr "La tua carta viene salvata in modo sicuro presso il nostro fornitore di pagamenti. Pagando, ci autorizzi ad addebitare questi importi sulla stessa carta a ogni rinnovo, finché non disdici. Puoi disdire in qualsiasi momento dal tuo account (Abbonamenti) o dal link nelle nostre email; il periodo già pagato resta attivo fino alla sua fine."

#. module: my_erp_crm_subscription
#. odoo-python
#: code:addons/my_erp_crm_subscription/models/abbonamento.py:0
msgid ""
"Your subscription %(name)s has been cancelled. It stays active until "
"%(date)s and will not be renewed."
msgstr "Il tuo abbonamento %(name)s è stato disdetto. Resta attivo fino al %(date)s e non verrà rinnovato."

#. module: my_erp_crm_subscription
#. odoo-python
#: code:addons/my_erp_crm_subscription/models/abbonamento.py:0
msgid "Your subscription %s has been cancelled"
msgstr "Il tuo abbonamento %s è stato disdetto"

#. module: my_erp_crm_subscription
#. odoo-python
#: code:addons/my_erp_crm_subscription/models/abbonamento.py:0
msgid "Your subscription %s is due for renewal"
msgstr "Il tuo abbonamento %s è da rinnovare"

#. module: my_erp_crm_subscription
#: model_terms:ir.ui.view,arch_db:my_erp_crm_subscription.portal_my_abbonamento
msgid ""
"Your subscription has been cancelled. It will not be renewed and stays "
"active until the end of the period already paid."
msgstr "Il tuo abbonamento è stato disdetto. Non verrà rinnovato e resta attivo fino alla fine del periodo già pagato."

#. module: my_erp_crm_subscription
#: model_terms:ir.ui.view,arch_db:my_erp_crm_subscription.portal_my_abbonamento
msgid "Your subscription has been reactivated: it will be renewed as before."
msgstr "Il tuo abbonamento è stato riattivato: si rinnoverà come prima."

#. module: my_erp_crm_subscription
#. odoo-python
#: code:addons/my_erp_crm_subscription/models/abbonamento.py:0
#: code:addons/my_erp_crm_subscription/models/sale_order.py:0
msgid "every month"
msgstr "ogni mese"

#. module: my_erp_crm_subscription
#. odoo-python
#: code:addons/my_erp_crm_subscription/models/abbonamento.py:0
#: code:addons/my_erp_crm_subscription/models/sale_order.py:0
