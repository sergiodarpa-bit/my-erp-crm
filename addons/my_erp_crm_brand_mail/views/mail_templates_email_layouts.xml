<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- "Powered by Odoo" in fondo alle email diventa "Powered by my-erp-crm"
         (la parte "Powered by" resta tradotta nella lingua del destinatario). -->
    <template id="mail_notification_layout" inherit_id="mail.mail_notification_layout">
        <xpath expr="//a[contains(@href, 'utm_medium=email')]" position="replace">
            <a target="_blank" href="https://github.com/sergiodarpa-bit/my-erp-crm"
               t-att-style="'color: ' + (company.email_secondary_color or '#875A7B') + ';'">my-erp-crm</a>
        </xpath>
    </template>

    <template id="mail_notification_light" inherit_id="mail.mail_notification_light">
        <xpath expr="//a[contains(@href, 'utm_medium=email')]" position="replace">
            <a target="_blank" href="https://github.com/sergiodarpa-bit/my-erp-crm"
               t-att-style="'color: ' + (company.email_secondary_color or '#875A7B') + ';'">my-erp-crm</a>
        </xpath>
    </template>

</odoo>
