<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- In fondo alle email il testo dice già «Powered by my-erp-crm» (scripts/rebrand.py):
         si cambia solo l'indirizzo, senza toccare la struttura su cui si appoggiano altri moduli. -->
    <template id="mail_notification_layout" inherit_id="mail.mail_notification_layout" priority="1">
        <xpath expr="//a[contains(@href, 'utm_medium=email')]" position="attributes">
            <attribute name="href">https://github.com/sergiodarpa-bit/my-erp-crm</attribute>
        </xpath>
    </template>

    <template id="mail_notification_light" inherit_id="mail.mail_notification_light" priority="1">
        <xpath expr="//a[contains(@href, 'utm_medium=email')]" position="attributes">
            <attribute name="href">https://github.com/sergiodarpa-bit/my-erp-crm</attribute>
        </xpath>
    </template>

</odoo>
