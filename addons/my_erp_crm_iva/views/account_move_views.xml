<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_vat_proofs" model="ir.ui.view">
        <field name="name">account.move.form.vat.proofs</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']//field[@name='fiscal_position_id']" position="after">
                <field name="oss_location_proof_1"
                       invisible="not fiscal_position_id or move_type not in ('out_invoice', 'out_refund')"
                       readonly="state != 'draft'"/>
                <field name="oss_location_proof_2"
                       invisible="not fiscal_position_id or move_type not in ('out_invoice', 'out_refund')"
                       readonly="state != 'draft'"/>
                <field name="vat_treatment_proof" invisible="not vat_treatment_proof"/>
            </xpath>
        </field>
    </record>
</odoo>
