<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_position_form_vat_rules" model="ir.ui.view">
        <field name="name">account.fiscal.position.form.vat.rules</field>
        <field name="model">account.fiscal.position</field>
        <field name="inherit_id" ref="account.view_account_position_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat_required']" position="after">
                <field name="vies_required"/>
                <field name="oss_location_proofs_required"/>
            </xpath>
        </field>
    </record>
</odoo>
